{
  "name": "enshield-shipping-protection",
  "version": "0.1.0",
  "description": "Internal package for Gadget app enshield-shipping-protection (Development environment)",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "vite build",
    "test": "node --test tests/*.test.mjs && yarn test:ui",
    "test:ui": "vitest run --config vitest.config.js",
    "test:e2e": "playwright test",
    "test:frontend": "yarn test:ui && yarn test:e2e",
    "shopify": "shopify",
    "shopify:config:use:development": "shopify app config use shopify.app.development.toml",
    "shopify:config:use:production": "shopify app config use shopify.app.toml",
    "shopify:dev": "yarn shopify:deploy:development && yarn shopify:config:use:development && shopify app dev --no-update",
    "shopify:deploy:development": "yarn shopify:config:use:development && shopify app deploy --allow-updates",
    "shopify:deploy:production": "yarn shopify:config:use:production && shopify app deploy --allow-updates",
    "shopify:deploy": "yarn shopify:deploy:production",
    "shopify:info": "shopify app info",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gadget-client/enshield-shipping-protection": "link:.gadget/client",
    "@gadgetinc/react": "^0.24.1",
    "@gadgetinc/react-shopify-app-bridge": "^0.21.1",
    "@shopify/app-bridge-react": "4.2.3",
    "@shopify/polaris": "^13.8.0",
    "@shopify/polaris-icons": "^9.3.0",
    "framer-motion": "^11.15.0",
    "gadget-server": "link:.gadget/server",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-router": "^7.14.1",
    "shopify-api-node": "^3.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.1",
    "@shopify/app": "^3.58.2",
    "@shopify/cli": "^4.5.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.14",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react-swc": "^3.8.1",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
