<mvt:comment>Product Gallery V2 partial. Uses the configured native Miva image machine.</mvt:comment>
<section class="sd2-v2-pdp-gallery" aria-label="Product media">
	<div class="sd2-v2-media" data-v2-gallery>
		<div class="x-product-layout-images" data-PhotoGallery role="group" style="--prod-img-x: &mvte:product_display_imagemachine:image_width;px; --prod-img-y: &mvte:product_display_imagemachine:image_height;px; --prod-thumb-x: &mvte:product_display_imagemachine:thumb_width;px; --prod-thumb-y: &mvte:product_display_imagemachine:thumb_height;px;">
			<section aria-label="Product image thumbnails" class="splide x-filmstrip-wrapper" data-filmstrip-wrapper><div class="splide__track x-filmstrip" data-filmstrip><ul class="splide__list x-filmstrip__list" id="thumbnails"></ul></div></section>
			<div class="x-product-layout-images__main-image sd2-v2-media__viewer" id="main_image" data-v2-zoom-viewer><div id="filmstrip-video-iframe-container" class="u-hidden"></div><section class="splide" data-photograph><div class="splide__track"><ul class="splide__list" id="product-image-list"></ul></div></section><button class="sd2-v2-media__zoom" type="button" data-v2-zoom-toggle aria-label="Toggle product image zoom">Zoom</button></div>
			<mvt:item name="product_display_imagemachine" param="body_deferred:product:id" />
		</div>
	</div>
</section>
