<mvt:item name="html_profile" />
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<base href="&mvt:global:basehref;">
	<mvt:if expr="NOT ISNULL l.settings:page:title">
		<title>&mvt:page:title;</title>
	<mvt:else>
		<title>&mvt:store:name;: &mvt:page:name;</title>
	</mvt:if>
	<mvt:if expr="g.useDevResources EQ 1"><mvt:item name="head" param="css_list_dev" /><mvt:else><mvt:item name="head" param="css_list" /></mvt:if>
	<mvt:item name="head" param="head_tag" />
</head>
<body id="js-&mvte:page:code;" class="o-site-wrapper t-page-&mvt:global:pageClass;">
	<mvt:item name="hdft" param="global_header" />
	<mvt:item name="hdft" param="header" />

	<main class="sd2-v2-auth" data-v2-auth>
		<header class="sd2-v2-account-hero">
			<p class="sd2-kicker">Account security</p>
			<h1>&mvt:page:name;</h1>
			<p>Create a secure new password for your account.</p>
		</header>

		<mvt:item name="readytheme" param="contentsection( 'messages' )" />

		<section class="sd2-v2-auth__panel">
			<form data-hook="cpca-form" method="post" action="&mvte:urls:CSTR:secure;" autocomplete="off">
				<fieldset>
					<legend>&mvt:page:name;</legend>
					<input type="hidden" name="Action" value="CSTR" />
					<input type="hidden" name="CSRF_Token" value="&mvte:global:Basket:csrf_token;" />
					<input type="hidden" name="Customer_PasswordResetToken" value="&mvte:global:Customer_PasswordResetToken;" />
					<mvt:do file="g.Module_Feature_CUS_DB" name="l.success" value="CustomerSettings_Load(l.settings:customersettings)" />
					<p class="sd2-v2-validation">
						<strong>Requirements</strong><br>
						Minimum Password Length: &mvt:customersettings:pw_min_len;
						<mvt:if expr="l.settings:customersettings:pw_complex EQ 1">
							&mdash; At Least one Letter and one Number or Punctuation Character
						<mvt:elseif expr="l.settings:customersettings:pw_complex EQ 2">
							&mdash; Mixed Case Letters and at Least one Number or Punctuation Character
						</mvt:if>
					</p>
					<p>Please enter your new password.</p>
					<ul class="sd2-v2-account-fields sd2-v2-account-fields--wide">
						<li class="sd2-v2-account-field sd2-v2-account-field--full">
							<mvt:if expr="g.Customer_Password_Invalid">
								<label class="u-color-red" for="Customer_PasswordResetNewPassword">New Password</label>
							<mvt:else>
								<label for="Customer_PasswordResetNewPassword">New Password</label>
							</mvt:if>
							<input id="Customer_PasswordResetNewPassword" type="password" name="Customer_PasswordResetNewPassword" autocomplete="new-password" required>
						</li>
						<li class="sd2-v2-account-field sd2-v2-account-field--full">
							<mvt:if expr="g.Customer_VerifyPassword_Invalid">
								<label class="u-color-red" for="Customer_PasswordResetVerifyNewPassword">Confirm Password</label>
							<mvt:else>
								<label for="Customer_PasswordResetVerifyNewPassword">Confirm Password</label>
							</mvt:if>
							<input id="Customer_PasswordResetVerifyNewPassword" type="password" name="Customer_PasswordResetVerifyNewPassword" autocomplete="new-password" required>
						</li>
					</ul>
					<div class="sd2-v2-account-actions">
						<input class="sd2-btn sd2-btn--primary" type="submit" value="Update" title="Click Here to Change Your Password">
					</div>
				</fieldset>
			</form>
		</section>
	</main>

	<mvt:item name="hdft" param="footer" />
	<mvt:item name="hdft" param="global_footer" />
</body>
</html>
