<!DOCTYPE html>
<html>
<mvt:item name="html_profile" />
<head>
	<mvt:if expr="NOT ISNULL l.settings:category:page_title"><title>&mvte:category:page_title;</title><mvt:else><title>&mvte:category:name; | &mvte:store:name;</title></mvt:if>
	<mvt:assign name="l.settings:category:stripped_descrip" value="miva_html_strip( l.settings:category:descrip, '' )" />
	<mvt:if expr="ISNULL l.settings:category:stripped_descrip"><mvt:assign name="l.settings:category:stripped_descrip" value="'Shop ' $ l.settings:category:name $ ' diesel performance parts with fitment-focused product information from Sinister Diesel.'" /></mvt:if>
	<meta name="description" content="&mvte:category:stripped_descrip;">
	<mvt:assign name="g.sd2_seo_description" value="l.settings:category:stripped_descrip" />
	<mvt:if expr="g.useDevResources EQ 1"><mvt:item name="head" param="css_list_dev" /><mvt:else><mvt:item name="head" param="css_list" /></mvt:if>
	<mvt:item name="head" param="head_tag" />
	<mvt:comment>
		Product Listing V2 staging template. Inactive only.
		Do not assign over live CTGY listing templates.
		The registered category_listing item owns native product data, sorting,
		per-page controls, pagination, add-to-basket fields, and empty states.
	</mvt:comment>
</head>
<body>
	<mvt:item name="hdft" param="global_header" />
	<mvt:item name="hdft" param="header" />

<main class="sd2-v2-search-page" data-v2-listing-page>
	<div class="sd2-wrap">
		<header class="sd2-v2-search-page__head sd2-reveal" data-reveal="fade-up">
			<nav class="sd2-v2-breadcrumbs" aria-label="Breadcrumb">
				<a href="&mvte:urls:SFNTV2:auto;">Home</a>
				<span aria-hidden="true">/</span>
				<span>&mvte:category:name;</span>
			</nav>
			<div class="sd2-v2-search-page__title-row">
				<div>
					<p class="sd2-eyebrow">Product Listing</p>
					<h1 class="sd2-heading-lg">&mvte:category:name;</h1>
				</div>
				<p class="sd2-v2-search-page__count">&mvte:category_listing:total_prod_count; products</p>
			</div>
			<div class="sd2-v3-hero-data" aria-label="Catalog status">
				<div><span>Products</span><strong>&mvte:category_listing:total_prod_count;</strong></div>
				<div><span>Catalog</span><strong>Live</strong></div>
				<div><span>Fitment</span><strong data-v2-fitment-copy>Select your truck</strong></div>
			</div>
			<mvt:item name="readytheme" param="contentsection( 'vehicle_banner' )" />
		</header>

		<section class="sd2-v3-commerce-stage" data-sd2-story aria-label="Browse &mvte:category:name;">
			<div class="sd2-v2-result-tools sd2-reveal" data-reveal="fade-up">
				<div class="sd2-v2-chips" data-v2-filter-chips><span class="sd2-v2-chip">&mvte:category:name;</span></div>
				<mvt:if expr="l.settings:facets:facet_count GT 0">
					<button class="sd2-v2-filter-trigger" type="button" data-v2-filter-open aria-controls="sd2-v2-listing-filter-sheet" aria-expanded="false"><span>Filter Parts</span><strong>&mvte:facets:facet_count;</strong></button>
				</mvt:if>
			</div>

			<mvt:if expr="l.settings:facets:facet_count GT 0">
				<mvt:assign name="l.settings:sd2_ctgy_layout_class" value="'sd2-v2-search-page__layout sd2-v2-search-page__layout--has-filters'" />
			<mvt:else>
				<mvt:assign name="l.settings:sd2_ctgy_layout_class" value="'sd2-v2-search-page__layout sd2-v2-search-page__layout--no-filters'" />
			</mvt:if>
			<section class="&mvte:sd2_ctgy_layout_class;" aria-label="Category products">
				<mvt:if expr="l.settings:facets:facet_count GT 0">
					<div class="sd2-v2-filter-sheet-scrim" data-v2-filter-close hidden></div>
					<aside class="sd2-v2-filter-rail sd2-v2-filter-sheet" id="sd2-v2-listing-filter-sheet" data-v2-filter-sheet aria-hidden="true" aria-label="Category filters">
						<div class="sd2-v2-filter-sheet__head"><div><span>Catalog Control</span><strong>Filter Parts</strong></div><button type="button" data-v2-filter-close aria-label="Close filters">&times;</button></div>
						<div class="sd2-v2-filter-sheet__body"><mvt:item name="facets" /></div>
						<div class="sd2-v2-filter-sheet__foot"><button class="sd2-btn sd2-btn--primary sd2-btn--full" type="button" data-v2-filter-close>View Products</button></div>
					</aside>
				</mvt:if>

				<mvt:item name="category_listing" />
			</section>
		</section>
	</div>
</main>

	<mvt:item name="hdft" param="footer" />
	<mvt:item name="hdft" param="global_footer" />
</body>
</html>
