<mvt:item name="html_profile" />
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<base href="&mvt:global:basehref;">
	<mvt:if expr="NOT ISNULL l.settings:page:title">
		<title>&mvt:page:title;</title>
	<mvt:else>
		<title>&mvt:store:name;: &mvt:page:name;</title>
	</mvt:if>
	<mvt:if expr="g.useDevResources EQ 1"><mvt:item name="head" param="css_list_dev" /><mvt:else><mvt:item name="head" param="css_list" /></mvt:if>
	<mvt:item name="head" param="head_tag" />
</head>
<body id="js-&mvte:page:code;" class="o-site-wrapper t-page-&mvt:global:pageClass; sd2-v2-state-page sd2-v2-upsell-page">
	<mvt:item name="hdft" param="global_header" />

	<main class="sd2-v2-state-shell">
	<section class="o-layout">
		<div class="o-layout__item u-width-12">
			<section class="t-expanded-block t-account-landing-section u-bg-white">
				<section class="o-layout">
					<div class="o-layout__item">
						<mvt:item name="hdft" param="header" />
						<h1 class="sd2-v2-heading-delta u-text-uppercase u-text-center">
							Special Offer
							<span class="sd2-v2-heading--subheading u-block">Offer valid for this order only</span>
						</h1>
					</div>
				</section>
			</section>
			<section class="t-expanded-block t-account-landing-section u-bg-white">
				<div class="o-layout__item t-expanded-block__item t-account-landing-section__content">
					<section class="o-layout">
						<div class="o-layout__item">
							<mvt:if expr="g.Upsold_Product_Count LE g.Upsell_Options:prod_sell OR g.Upsell_Options:prod_sell EQ 0">
								<p>You may select <strong class="u-text-bold">one or more</strong> of the following:</p>
							<mvt:elseif expr="g.Upsell_Options:prod_sell EQ 1">
								<p>You may select <strong class="u-text-bold">one</strong> of the following:</p>
							<mvt:else>
								<p>You may select up to <strong class="u-text-bold">&mvte:global:Upsell_Options:prod_sell;</strong> of the following:</p>
							</mvt:if>
							<form method="post" action="&mvte:urls:OSEL:secure;">
								<fieldset>
									<legend>&mvt:page:name;</legend>
									<input type="hidden" name="Action" value="AUPM">
									<input type="hidden" name="Attributes" value="Yes">
									<input type="hidden" name="Upsell_Product_Count" value="&mvte:global:Upsold_Product_Count;">
									<mvt:item name="tax" />
						
									<table class="sd2-v2-table-responsive">
										<thead class="sd2-v2-table-responsive_thead u-text-left">
											<tr class="sd2-v2-table-responsive__row u-text-uppercase u-font-tiny u-color-gray-30">
												<th class="sd2-v2-table-responsive__cell" scope="col">&nbsp;</th>
												<th class="sd2-v2-table-responsive__cell" scope="col">Code</th>
												<th class="sd2-v2-table-responsive__cell" scope="col">Product</th>
												<th class="sd2-v2-table-responsive__cell" scope="col">Regularly</th>
												<th class="sd2-v2-table-responsive__cell" scope="col">Special</th>
												<th class="sd2-v2-table-responsive__cell" scope="col">Save</th>
											</tr>
										</thead>
										<tbody>
											<mvt:foreach array="upsale" iterator="upsold_product">
												<tr class="sd2-v2-table-responsive__row">
													<td class="sd2-v2-table-responsive__cell" data-label="">
														<label class="sd2-v2-form-checkbox u-text-bold">
															<mvt:if expr="l.settings:upsold_product:selected">
																<input class="sd2-v2-form-checkbox__input" type="checkbox" name="Upsell_Selected[&mvt:upsold_product:index;]" value="Yes" checked>
																<span class="sd2-v2-form-checkbox__caption">Buy</span>
															<mvt:else>
																<input class="sd2-v2-form-checkbox__input" type="checkbox" name="Upsell_Selected[&mvt:upsold_product:index;]" value="Yes">
																<span class="sd2-v2-form-checkbox__caption">Buy</span>
															</mvt:if>
														</label>
														<input type="hidden" name="Product[&mvt:upsold_product:index;]:code" value="&mvte:upsold_product:code;">
														<input type="hidden" name="Product[&mvt:upsold_product:index;]:options[UPSELL]" value="Yes">
													</td>
													<td class="sd2-v2-table-responsive__cell sd2-v2-table-responsive__cell--flex" data-label="Code">&mvt:upsold_product:code;</td>
													<td class="sd2-v2-table-responsive__cell sd2-v2-table-responsive__cell--flex" data-label="Product">&mvt:upsold_product:name;</td>
													<td class="sd2-v2-table-responsive__cell sd2-v2-table-responsive__cell--flex" data-label="Regularly">&mvt:upsold_product:formatted_price;</td>
													<td class="sd2-v2-table-responsive__cell sd2-v2-table-responsive__cell--flex" data-label="Special">&mvt:upsold_product:formatted_upsell_price;</td>
													<td class="sd2-v2-table-responsive__cell sd2-v2-table-responsive__cell--flex" data-label="Save">&mvt:upsold_product:formatted_upsell_savings;</td>
												</tr>
											</mvt:foreach>
										</tbody>
									</table>

									<p class="u-text-right">
										<input class="sd2-btn sd2-btn--large u-bg-primary u-font-small u-text-bold u-text-uppercase" type="submit" value="Continue">
									</p>
								</fieldset>
							</form>
						</div>
					</section>

					<mvt:item name="hdft" param="footer" />
				</div>
			</section>
		</div>
	</section>
	</main>

	<mvt:item name="hdft" param="global_footer" />
</body>
</html>
