			<section class="sd2-v2-embed-stage" aria-label="&mvte:page:name;"><iframe class="sd2-v2-partner-embed sd2-v2-partner-embed--long" src="https://t.lt02.net/lp/F8R8pTXl/email/" title="&mvte:page:name; form" loading="eager" allowfullscreen></iframe></section>
		</div>
	</main>
	<mvt:item name="hdft" param="global_footer" />
</body>
