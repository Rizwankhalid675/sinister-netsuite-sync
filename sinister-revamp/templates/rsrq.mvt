<mvt:item name="html_profile" />
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<base href="&mvt:global:basehref;">
	<mvt:if expr="NOT ISNULL l.settings:page:title">
		<title>&mvt:page:title;</title>
	<mvt:else>
		<title>&mvt:store:name;: &mvt:page:name;</title>
	</mvt:if>
	<mvt:if expr="g.useDevResources EQ 1"><mvt:item name="head" param="css_list_dev" /><mvt:else><mvt:item name="head" param="css_list" /></mvt:if>
	<mvt:item name="head" param="head_tag" />
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
</head>
<body id="js-&mvte:page:code;" class="o-site-wrapper t-page-&mvt:global:pageClass; sd2-v2-state-page sd2-v2-request-page">
	<mvt:item name="hdft" param="global_header" />
	<mvt:item name="hdft" param="header" />

	<main class="sd2-v2-state-shell">
	<section class="o-layout sd2-v2-state-content">
		<div class="o-layout__item u-width-12">
			<section class="t-expanded-block t-account-landing-section u-bg-white">
				<header class="t-account-landing-section__header">
					<p class="sd2-kicker">Partner network</p>
					<h1 class="t-account-landing-section__heading">&mvte:page:name;</h1>
				</header>
				<div class="t-account-landing-section__content">
					<mvt:item name="readytheme" param="contentsection( 'messages' )" />
					<div class="sd2-v2-account-grid">
						<section class="sd2-v2-account-main">
							<mvt:item name="readytheme" param="contentsection( 'reseller_request' )" />
						</section>
						<aside class="sd2-v2-account-side" aria-label="Information navigation">
							<mvt:item name="readytheme" param="navigationset( 'static_navigation' )" />
						</aside>
					</div>
				</div>
			</section>
		</div>
	</section>
	</main>

	<mvt:item name="hdft" param="footer" />
	<mvt:item name="hdft" param="global_footer" />
</body>
</html>
