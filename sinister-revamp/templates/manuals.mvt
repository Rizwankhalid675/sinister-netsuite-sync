<mvt:item name="html_profile" />
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<base href="&mvte:global:basehref;">
	<mvt:if expr="NOT ISNULL l.settings:page:title"><title>&mvt:page:title;</title><mvt:else><title>&mvt:page:name; | &mvt:store:name;</title></mvt:if>
	<mvt:if expr="g.useDevResources EQ 1"><mvt:item name="head" param="css_list_dev" /><mvt:else><mvt:item name="head" param="css_list" /></mvt:if>
	<mvt:item name="head" param="head_tag" />
</head>
<body class="single-column sd2-v2-sequence-page sd2-v2-manuals-page">
	<mvt:item name="hdft" param="global_header" />
	<mvt:item name="hdft" param="header" />
	<main class="sd2-v2-search-page" data-v2-editorial-page data-editorial-variant="resource-library">
		<div class="sd2-wrap">
			<header class="sd2-v2-search-page__head"><nav class="sd2-v2-breadcrumbs" aria-label="Breadcrumb"><a href="&mvte:urls:SFNT:auto;">Home</a><span aria-hidden="true">/</span><span>&mvte:page:name;</span></nav><p class="sd2-eyebrow">Technical library</p><h1 class="sd2-heading-lg">Truck manuals</h1></header>
			<section class="mm-sequence-container sd2-v2-sequence-stage" aria-label="Truck manuals"><mvt:item name="sequence" /></section>
		</div>
	</main>
	<mvt:item name="hdft" param="footer" />
	<mvt:item name="hdft" param="global_footer" />
</body>
</html>
