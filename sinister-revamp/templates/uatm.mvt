<mvt:item name="html_profile" />
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<base href="&mvt:global:basehref;">
	<mvt:if expr="NOT ISNULL l.settings:page:title">
		<title>&mvt:page:title;</title>
	<mvt:else>
		<title>&mvt:store:name;: &mvt:page:name;</title>
	</mvt:if>
	<mvt:if expr="g.useDevResources EQ 1"><mvt:item name="head" param="css_list_dev" /><mvt:else><mvt:item name="head" param="css_list" /></mvt:if>
	<mvt:item name="head" param="head_tag" />
</head>
<body id="js-&mvte:page:code;" class="o-site-wrapper t-page-&mvt:global:pageClass; sd2-v2-state-page sd2-v2-attribute-state-page">
	<mvt:item name="hdft" param="global_header" />

	<main class="sd2-v2-state-shell">
	<section class="o-layout sd2-v2-state-content">
		<div class="o-layout__item u-width-12">
			<div class="t-expanded-block t-account-landing-section u-bg-white">
				<div class="o-layout__item t-expanded-block__item t-account-landing-section__content">
					<section class="o-layout">
						<div class="o-layout__item">
							<mvt:item name="readytheme" param="contentsection( 'messages' )" />
							<mvt:item name="hdft" param="header" />
						</div>
					</section>
				
					<section class="o-layout o-layout--justify-center">
						<div class="o-layout__item u-width-12 u-width-6--m u-width-4--l">
							<form method="post" action="&mvte:urls:_self:rr;">
								<fieldset>
									<legend>Missing Required Attributes</legend>
									<input type="hidden" name="Action" value="&mvte:global:Action;">
									<input type="hidden" name="Upsell_Product_Count" value="&mvte:global:Upsell_Product_Count;">
									<mvt:item name="tax" />
									<ul class="sd2-v2-form-list">
										<li class="sd2-v2-form-list__item sd2-v2-form-list__item--full t-multiple-product-upsell-purchase__options">
											<mvt:item name="upsell_attr_mult" />
										</li>
										<li class="sd2-v2-form-list__item u-text-right">
											<input class="sd2-btn sd2-btn--large u-bg-primary u-font-small u-text-bold u-text-uppercase" type="submit" value="Continue">
										</li>
									</ul>
								</fieldset>
							</form>
						</div>
					</section>
		
					<mvt:item name="hdft" param="footer" />
				</div>
			</div>
		</div>
	</section>
	</main>

	<mvt:item name="hdft" param="global_footer" />
</body>
</html>
