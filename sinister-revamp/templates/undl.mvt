<mvt:item name="html_profile" />
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<base href="&mvt:global:basehref;">
	<mvt:if expr="NOT ISNULL l.settings:page:title">
		<title>&mvt:page:title;: &mvt:page:name;</title>
	<mvt:else>
		<title>&mvt:store:name;</title>
	</mvt:if>
	<mvt:if expr="g.useDevResources EQ 1"><mvt:item name="head" param="css_list_dev" /><mvt:else><mvt:item name="head" param="css_list" /></mvt:if>
	<mvt:item name="head" param="head_tag" />
<script src="https://www.google.com/recaptcha/api.js" async defer></script>

</head>
<body id="js-&mvte:page:code;" class="o-site-wrapper t-page-&mvt:global:pageClass; sd2-v2-state-page sd2-v2-request-page">
	<mvt:item name="hdft" param="global_header" />

	<main class="sd2-v2-state-shell">
	<section class="o-layout sd2-v2-state-content">
		<div class="o-layout__item u-width-12">
			<section class="t-expanded-block u-bg-white">
				<div class="o-layout__item t-expanded-block__item">
					<br>
					<div class="o-layout o-layout--column-reverse o-layout--row-reverse--l">
						<div class="o-layout__item u-width-12 u-width-9--l u-width-10--w">
							<section class="o-layout">
								<div class="o-layout__item">
									<h1 class="sd2-v2-heading-delta u-color-primary">&mvte:page:name;</h1>
									<hr class="sd2-v2-keyline">
								</div>
							</section>
					
							<mvt:item name="hdft" param="header" />

							<section class="o-layout">
								<mvt:item name="readytheme" param="contentsection( 'undelete-kit' )" />
							</section>

							<mvt:item name="hdft" param="footer" />
						</div>
						<aside class="o-layout__item u-width-12 u-width-3--l u-width-2--w">
							<mvt:item name="readytheme" param="navigationset( 'static_navigation' )" />
						</aside>
					</div>
					<br>
				</div>
			</section>
		</div>
	</section>
	</main>

	<mvt:item name="hdft" param="global_footer" />
</body>
</html>
