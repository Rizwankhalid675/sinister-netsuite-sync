<mvt:item name="html_profile" />
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<base href="&mvte:global:basehref;">
	<mvt:if expr="NOT ISNULL l.settings:category:page_title">
		<title>&mvt:category:page_title;</title>
	<mvt:elseif expr="NOT ISNULL l.settings:page:title">
		<title>&mvt:page:title;</title>
	<mvt:else>
		<title>&mvt:store:name;: &mvt:category:name;</title>
	</mvt:if>
	<mvt:if expr="g.useDevResources EQ 1"><mvt:item name="head" param="css_list_dev" /><mvt:else><mvt:item name="head" param="css_list" /></mvt:if>
	<mvt:item name="head" param="head_tag" />
</head>
<body id="js-&mvte:page:code;" class="sd2-v2-brand-hub-page">
	<mvt:item name="hdft" param="global_header" />
	<mvt:item name="hdft" param="header" />

	<mvt:item name="customfields" param="Read_Category_Code(g.Category_Code, 'secondary_title_image', l.settings:secondary_title_image)" />
	<mvt:do name="l.result" file="g.Module_Library_DB" value="Runtime_CategoryList_Load_Parent(l.settings:category:id, l.settings:subcategories)"/>
	<mvt:assign name="l.settings:subcategory_count" value="miva_array_elements(l.settings:subcategories)" />

	<main class="sd2-v2-search-page" data-v2-editorial-page data-editorial-variant="brand-directory">
		<div class="sd2-wrap">
			<header class="sd2-v2-search-page__head">
				<nav class="sd2-v2-breadcrumbs" aria-label="Breadcrumb">
					<a href="&mvte:urls:SFNT:auto;">Home</a><span aria-hidden="true">/</span><span>&mvte:category:name;</span>
				</nav>
				<p class="sd2-eyebrow">Shop by manufacturer</p>
				<h1 class="sd2-heading-lg">&mvte:category:name;</h1>
			</header>

			<div class="sd2-v2-static-page sd2-v2-brand-hub">
				<div class="sd2-v2-static-page__layout">
					<div class="sd2-v2-static-page__main">
						<div class="sd2-v2-static-page__body">
							<mvt:item name="prod_ctgy_hdft" param="ctgy_header" />
							<mvt:if expr="NOT ISNULL l.settings:secondary_title_image">
								<img class="sd2-v2-brand-hub__banner" src="&mvte:secondary_title_image;" alt="&mvte:category:name;" loading="lazy" decoding="async">
							</mvt:if>

							<mvt:if expr="l.settings:subcategory_count GT 0">
								<section class="sd2-v2-brand-grid" aria-label="&mvte:category:name; brands">
									<mvt:foreach iterator="subcategory" array="subcategories">
										<mvt:assign name="l.uri:store_id" value="g.Store:id"/>
										<mvt:assign name="l.uri:cat_id" value="l.settings:subcategory:id"/>
										<mvt:do file="g.Module_Feature_URI_DB" name="l.have_uri" value="URI_Load_Item_Canonical(l.uri, l.settings:subcategory:link)"/>
										<a class="sd2-v2-brand-card" href="&mvte:subcategory:link:uri;">
											<span class="sd2-v2-brand-card__media">
												<mvt:if expr="NOT ISNULL l.settings:subcategory:image"><img src="&mvte:subcategory:image;" alt="" loading="lazy" decoding="async"><mvt:else><span aria-hidden="true">SD</span></mvt:if>
											</span>
											<span class="sd2-v2-brand-card__name">&mvte:subcategory:name;</span>
											<span class="sd2-v2-brand-card__action">View products <span aria-hidden="true">&rarr;</span></span>
										</a>
									</mvt:foreach>
								</section>
							<mvt:else>
								<mvt:item name="category_listing" />
							</mvt:if>
							<mvt:item name="prod_ctgy_hdft" param="ctgy_footer" />
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>

	<mvt:item name="hdft" param="footer" />
	<mvt:item name="hdft" param="global_footer" />
</body>
</html>
