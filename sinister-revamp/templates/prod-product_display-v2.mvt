<mvt:comment>
	Inactive Product Display V2 item. All commerce fields and integrations below are sourced
	from the verified PROD item/template configuration; no static product data is used.
</mvt:comment>

<mvt:if expr="(l.settings:state_via_ip EQ 'CA') AND l.settings:product:customfield_values:customfields:no_sale_california">
	<mvt:item name="california_restricted" />
</mvt:if>

<main class="sd2-v2-pdp" data-v2-pdp>
	<mvt:item name="readytheme" param="contentsection( 'product_promo_banner' )" />

	<header class="sd2-v2-product-hero">
		<nav class="sd2-v2-breadcrumbs" aria-label="Breadcrumb">
			<a href="&mvte:urls:SFNT:auto;">Home</a><span aria-hidden="true">/</span>
			<a href="&mvte:urls:CTGY:auto;">Parts</a><span aria-hidden="true">/</span>
			<span aria-current="page">&mvte:product:name;</span>
		</nav>
		<p class="sd2-kicker">Sinister Diesel Product</p>
		<h1>&mvte:product:name;</h1>
		<div class="sd2-v2-product-hero__meta">
			<span>SKU <mvt:if expr="NOT ISNULL l.settings:product:sku">&mvte:product:sku;<mvt:else>&mvte:product:code;</mvt:if></span>
			<span id="product_just_stars" class="reg aside" role="region" tabindex="-1" aria-label="Product rating summary"></span>
			<span data-v2-fitment-copy>Garage fitment not selected.</span>
		</div>
	</header>

	<section class="sd2-v2-fitment-confirm" aria-label="Vehicle fitment">
		<div class="sd2-v2-fitment-confirm__copy">
			<p class="sd2-kicker">Garage Fitment</p>
			<h2>Confirm This Part Against Your Build</h2>
			<p data-v2-fitment-copy>No vehicle selected. Open Garage to verify year, make, model, and engine before ordering.</p>
		</div>
		<button class="sd2-btn sd2-btn--secondary" type="button" data-v2-garage-toggle>Open Garage</button>
		<div data-v2-product-fitments hidden>
			<mvt:foreach iterator="fitment" array="product:customfield_values:combofacets:fitment"><span><mvt:eval expr="gettoken(l.settings:fitment,'>',1) $ ' ' $ gettoken(l.settings:fitment,'>',2) $ ' ' $ gettoken(l.settings:fitment,'>',3) $ ' ' $ gettoken(l.settings:fitment,'>',4)" /></span></mvt:foreach>
		</div>
	</section>

	<section class="sd2-v2-pdp__layout" aria-label="Product purchase area">
		<div class="sd2-v2-pdp__media">
			<mvt:if expr="NOT ISNULL l.settings:product:customfield_values:customfields:product_label AND l.settings:product:customfield_values:customfields:product_label NE 'none'">
				<span class="sd2-v2-badge">&mvte:product:customfield_values:customfields:product_label;</span>
			</mvt:if>
			<section class="sd2-v2-pdp-gallery" aria-label="Product media">
				<div class="sd2-v2-media" data-v2-gallery>
					<div class="x-product-layout-images" data-PhotoGallery role="group" style="--prod-img-x: &mvte:product_display_imagemachine:image_width;px; --prod-img-y: &mvte:product_display_imagemachine:image_height;px; --prod-thumb-x: &mvte:product_display_imagemachine:thumb_width;px; --prod-thumb-y: &mvte:product_display_imagemachine:thumb_height;px;">
						<section aria-label="Product image thumbnails" class="splide x-filmstrip-wrapper" data-filmstrip-wrapper>
							<div class="splide__track x-filmstrip" data-filmstrip><ul class="splide__list x-filmstrip__list" id="thumbnails"></ul></div>
						</section>
						<div class="x-product-layout-images__main-image sd2-v2-media__viewer" id="main_image" data-v2-zoom-viewer>
							<div id="filmstrip-video-iframe-container" class="u-hidden"></div>
							<section class="splide" data-photograph><div class="splide__track"><ul class="splide__list" id="product-image-list"></ul></div></section>
							<button class="sd2-v2-media__zoom" type="button" data-v2-zoom-toggle aria-label="Toggle product image zoom">Zoom</button>
						</div>
						<mvt:item name="product_display_imagemachine" param="body_deferred:product:id" />
					</div>
				</div>
			</section>
		</div>

		<aside class="sd2-v2-buybox" aria-label="Purchase options">
			<div class="sd2-v2-buybox__header"><p class="sd2-kicker">Product Detail</p><h2>&mvte:product:name;</h2></div>
			<div class="sd2-v2-price" aria-label="Product price">
				<span class="sd2-v2-price__label">Price</span>
				<div class="sd2-v2-price__row">
					<mvt:if expr="l.settings:product:base_price GT l.settings:product:price"><span class="sd2-v2-price__was"><s id="price-value-additional">&mvt:product:formatted_base_price;</s></span></mvt:if>
					<span class="sd2-v2-price__current" id="price-value" itemprop="price" content="&mvt:product:price;">&mvt:product:formatted_price;</span>
				</div>
			</div>
			<div id="product-discounts" class="sd2-v2-buybox__discounts" aria-live="polite">
				<mvt:foreach iterator="discount" array="product:discounts"><p>&mvte:discount:descrip;: <strong>&mvt:discount:formatted_discount;</strong></p></mvt:foreach>
			</div>
			<div class="sd2-v2-buybox__badges">
				<mvt:if expr="l.settings:product:inv_active OR l.settings:attributemachine:product:inv_active"><span class="sd2-v2-stock" id="inventory-message">&mvt:product:inv_long;</span><mvt:else><span class="sd2-v2-stock" id="inventory-message"></span></mvt:if>
				<mvt:if expr="l.settings:product:customfield_values:customfields:free_ground EQ 1 OR l.settings:product:customfield_values:customfields:free_ground EQ 3"><span class="sd2-v2-badge">Free ground shipping</span></mvt:if>
			</div>

			<form class="sd2-v2-buybox__form" id="apdr" data-hook="purchase" action="&mvte:urls:BASK:auto;" method="post" name="add" data-v2-buy-form>
				<input type="hidden" name="Old_Screen" value="&mvte:global:Screen;">
				<input type="hidden" name="Old_Search" value="&mvte:global:Search;">
				<input type="hidden" name="Action" value="ADPR">
				<input type="hidden" name="Product_Code" value="&mvte:product:code;">
				<input type="hidden" name="Product_Name" value="&mvtj:product:name;">
				<input type="hidden" name="Product_Price" value="&mvte:product:price;">
				<input type="hidden" name="Category_Code" value="&mvte:global:Category_Code;">
				<input type="hidden" name="Offset" value="&mvte:global:Offset;">
				<input type="hidden" name="AllOffset" value="&mvte:global:AllOffset;">
				<input type="hidden" name="CatListingOffset" value="&mvte:global:CatListingOffset;">
				<input type="hidden" name="RelatedOffset" value="&mvte:global:RelatedOffset;">
				<input type="hidden" name="SearchOffset" value="&mvte:global:SearchOffset;">
				<mvt:item name="extend" param="productfields" />
				<mvt:item name="discount_volume" param="product:id" />
				<div class="sd2-v2-buybox__attributes"><mvt:item name="product_attributes" param="product:id" /></div>
				<div><mvt:item name="extend" param="product" /></div>
				<div class="sd2-v2-buybox__message" data-hook="purchase-message" aria-live="polite"></div>
				<mvt:if expr="l.settings:product:inv_level NE 'out'">
					<mvt:if expr="(l.settings:state_via_ip NE 'CA') OR ISNULL l.settings:product:customfield_values:customfields:no_sale_california">
						<label class="sd2-v2-buybox__label" for="l-quantity">Quantity</label>
						<div class="sd2-v2-qty" data-v2-qty><button type="button" data-v2-qty-minus aria-label="Decrease quantity">-</button><input id="l-quantity" name="Quantity" type="tel" value="1" inputmode="numeric" data-v2-qty-input><button type="button" data-v2-qty-plus aria-label="Increase quantity">+</button></div>
						<div class="sd2-v2-buybox__native-button-wrap sd2-v2-buybox__native-button-wrap--primary" data-v2-buy-button data-hook="add-to-cart" data-action="&mvtj:urls:BASK:auto;" onclick="document.forms.add.action='&mvtj:urls:BASK:auto;';document.forms.add.elements.Action.value='ADPR';"><mvt:item name="buttons" param="AddToBasket" /></div>
					</mvt:if>
					<div class="sd2-v2-buybox__native-button-wrap sd2-v2-buybox__native-button-wrap--secondary" data-mmnodisable="true" onclick="document.forms.add.action='&mvtj:urls:WISH:secure;';document.forms.add.elements.Action.value='ATWL';"><mvt:item name="buttons" param="AddToWishList" /></div>
				<mvt:else><p class="sd2-v2-buybox__oos">This item is currently out of stock.</p></mvt:if>
				<mvt:if expr="(l.settings:state_via_ip NE 'CA') OR ISNULL l.settings:product:customfield_values:customfields:no_sale_california">
					<div class="sd2-v2-buybox__accelerated">
					<mvt:item name="mvaffirm_aslowas" param="product:product" />
					<mvt:item name="readytheme" param="contentsection( 'paypalcp_configuration' )" />
					<mvt:item name="paypalcp_buttons" param="product" />
					<mvt:item name="applepay" param="product" />
					</div>
				</mvt:if>
			</form>
			<p><a href="https://www.p65warnings.ca.gov/" rel="nofollow">California Prop 65 warning</a></p>
		</aside>
	</section>

	<div class="sd2-v2-sticky-buy" data-v2-sticky-buy>
		<div><strong>&mvte:product:name;</strong><span>&mvt:product:formatted_price;</span></div>
		<mvt:if expr="l.settings:product:inv_level NE 'out' AND ((l.settings:state_via_ip NE 'CA') OR ISNULL l.settings:product:customfield_values:customfields:no_sale_california)"><button class="sd2-btn sd2-btn--primary" type="button" onclick="document.forms.add.action='&mvtj:urls:BASK:auto;';document.forms.add.elements.Action.value='ADPR';document.forms.add.submit();">Add To Cart</button></mvt:if>
	</div>

	<section class="sd2-v2-pdp-section" id="description" aria-labelledby="sd2-v2-summary-title">
		<div class="sd2-v2-pdp-section__header"><p class="sd2-kicker">Overview</p><h2 id="sd2-v2-summary-title">Product Overview</h2></div>
		<div class="sd2-v2-pdp-copy">&mvt:product:descrip;</div>
	</section>

	<nav class="sd2-v2-product-tabs" aria-label="Product information">
		<a href="#specifications">Specifications</a>
		<mvt:if expr="NOT ISNULL l.settings:product:customfield_values:customfields:installation"><a href="#installation">Installation</a></mvt:if>
		<mvt:if expr="g.at_least_one_video"><a href="#videos">Videos</a></mvt:if>
		<a href="#reviews">Reviews</a><a href="#related-products">Related Products</a>
	</nav>

	<section class="sd2-v2-pdp-section" id="specifications" aria-labelledby="sd2-v2-specs-title">
		<div class="sd2-v2-pdp-section__header"><p class="sd2-kicker">Specifications</p><h2 id="sd2-v2-specs-title">Product Data &amp; Included Components</h2></div>
		<table class="sd2-v2-spec-table"><tbody>
			<tr><th scope="row">Item #</th><td>&mvte:product:code;</td></tr>
			<mvt:if expr="NOT ISNULL l.settings:product:sku"><tr><th scope="row">SKU</th><td>&mvte:product:sku;</td></tr></mvt:if>
			<mvt:if expr="l.settings:product:customfield_values:customfields:upc"><tr><th scope="row">UPC</th><td>&mvte:product:customfield_values:customfields:upc;</td></tr></mvt:if>
			<mvt:if expr="l.settings:product:weight NE 0"><tr><th scope="row">Shipping Weight</th><td>&mvt:product:weight; &mvte:store:wtunits;</td></tr></mvt:if>
		</tbody></table>
		<mvt:if expr="NOT ISNULL l.settings:product:customfield_values:customfields:specifications"><div class="sd2-v2-pdp-copy">&mvt:product:customfield_values:customfields:specifications;</div></mvt:if>
		<mvt:if expr="miva_array_elements(l.settings:product:customfield_values:combofacets:fitment)">
			<h3>Vehicle Applications</h3><ul class="sd2-v2-feature-list"><mvt:foreach iterator="fitment" array="product:customfield_values:combofacets:fitment"><li><mvt:eval expr="gettoken(l.settings:fitment,'>',1) $ ' ' $ gettoken(l.settings:fitment,'>',2) $ ' ' $ gettoken(l.settings:fitment,'>',3) $ ' ' $ gettoken(l.settings:fitment,'>',4)" /></li></mvt:foreach></ul>
		</mvt:if>
	</section>

	<mvt:if expr="NOT ISNULL l.settings:product:customfield_values:customfields:installation">
		<section class="sd2-v2-pdp-section" id="installation" aria-labelledby="sd2-v2-install-title">
			<div class="sd2-v2-pdp-section__header"><p class="sd2-kicker">Installation</p><h2 id="sd2-v2-install-title">Installation Documents</h2></div>
			<a class="sd2-btn sd2-btn--secondary" href="&mvte:product:customfield_values:customfields:installation;" target="_blank" rel="noopener">Download Install Instructions</a>
		</section>
	</mvt:if>

	<mvt:if expr="g.at_least_one_video">
		<section class="sd2-v2-pdp-section" id="videos" aria-labelledby="sd2-v2-videos-title">
			<div class="sd2-v2-pdp-section__header"><p class="sd2-kicker">Videos</p><h2 id="sd2-v2-videos-title">Product &amp; Installation Videos</h2></div>
			<div class="sd2-v2-pdp-feature-grid">
				<mvt:foreach iterator="video" array="product:videos_arr"><article><a href="&mvte:video:youtube_view_link;" target="_blank" rel="noopener"><img src="&mvte:video:youtube_tn;" alt="&mvte:product:name; video &mvte:video:count;" loading="lazy" decoding="async"><strong><mvt:if expr="l.settings:video:caption NE ''">&mvte:video:caption;<mvt:else>Watch product video</mvt:if></strong></a></article></mvt:foreach>
			</div>
		</section>
	</mvt:if>

	<section class="sd2-v2-pdp-section" id="reviews" aria-labelledby="sd2-v2-review-title">
		<div class="sd2-v2-pdp-section__header"><p class="sd2-kicker">Reviews</p><h2 id="sd2-v2-review-title">Customer Feedback</h2></div>
		<div id="shopper_review_page"><div id="review_header"></div><div id="product_page"></div><div id="review_image"><a href="https://www.shopperapproved.com/reviews/sinisterdiesel.com/" target="_blank" rel="nofollow noopener" aria-label="Read Sinister Diesel reviews on ShopperApproved"></a></div></div>
	</section>

	<section class="sd2-v2-pdp-section" id="related-products" aria-labelledby="sd2-v2-related-heading">
		<div class="sd2-v2-pdp-section__header"><p class="sd2-kicker">Related Products</p><h2 id="sd2-v2-related-heading">Built Around This Part</h2></div>
		<mvt:if expr="l.settings:related_product_count NE 0"><mvt:item name="related_products" /><mvt:else><p>No related products are currently available for this item.</p></mvt:if>
	</section>
</main>
