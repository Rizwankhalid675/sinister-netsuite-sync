<mvt:item name="html_profile" />
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<base href="&mvt:global:basehref;">
	<mvt:if expr="NOT ISNULL l.settings:page:title">
		<title>&mvt:page:title;</title>
	<mvt:else>
		<title>&mvt:store:name;: &mvt:page:name;</title>
	</mvt:if>
	<mvt:if expr="g.useDevResources EQ 1"><mvt:item name="head" param="css_list_dev" /><mvt:else><mvt:item name="head" param="css_list" /></mvt:if>
	<mvt:item name="head" param="head_tag" />
</head>
<body id="js-&mvte:page:code;" class="o-site-wrapper t-page-&mvt:global:pageClass;">
	<mvt:item name="hdft" param="global_header" />
	<mvt:item name="hdft" param="header" />

	<main class="sd2-v2-account" data-v2-account>
		<header class="sd2-v2-account-hero">
			<mvt:item name="breadcrumbs" />
			<p class="sd2-kicker">Account security</p>
			<h1>&mvt:page:name;</h1>
			<p>Update the email address used to sign in to your account.</p>
		</header>

		<mvt:item name="readytheme" param="contentsection( 'messages' )" />

		<section class="sd2-v2-account-card" aria-labelledby="sd2-v2-ceml-title">
			<h2 id="sd2-v2-ceml-title">Change Email Address</h2>
			<form method="post" action="&mvte:urls:CEML:secure;" autocomplete="off">
				<fieldset>
					<legend>&mvt:page:name;</legend>
					<input type="hidden" name="Action" value="CEML" />
					<input type="hidden" name="CSRF_Token" value="&mvte:global:Basket:csrf_token;">
					<p class="sd2-v2-validation">For security purposes, please enter your current password.</p>
					<ul class="sd2-v2-account-fields sd2-v2-account-fields--wide">
						<li class="sd2-v2-account-field sd2-v2-account-field--full">
							<mvt:if expr="g.Customer_CurrentPassword_Invalid">
								<label class="u-color-red" for="l-Customer_CurrentPassword">Current Password</label>
							<mvt:else>
								<label for="l-Customer_CurrentPassword">Current Password</label>
							</mvt:if>
							<input id="l-Customer_CurrentPassword" type="password" name="Customer_CurrentPassword" autocomplete="current-password" required>
						</li>
						<li class="sd2-v2-account-field sd2-v2-account-field--full">
							<p><strong>Current email address</strong><br>&mvte:global:Customer:pw_email;</p>
						</li>
						<li class="sd2-v2-account-field">
							<mvt:if expr="g.Customer_LoginEmail_Invalid">
								<label class="u-color-red" for="l-Customer_LoginEmail">New Email Address</label>
							<mvt:else>
								<label for="l-Customer_LoginEmail">New Email Address</label>
							</mvt:if>
							<input id="l-Customer_LoginEmail" type="email" name="Customer_LoginEmail" autocomplete="email" required>
						</li>
						<li class="sd2-v2-account-field">
							<mvt:if expr="g.Customer_VerifyLoginEmail_Invalid">
								<label class="u-color-red" for="l-Customer_VerifyLoginEmail">Confirm Email Address</label>
							<mvt:else>
								<label for="l-Customer_VerifyLoginEmail">Confirm Email Address</label>
							</mvt:if>
							<input id="l-Customer_VerifyLoginEmail" type="email" name="Customer_VerifyLoginEmail" autocomplete="email" required>
						</li>
					</ul>
					<div class="sd2-v2-account-actions">
						<mvt:item name="buttons" param="Save" />
					</div>
				</fieldset>
			</form>
		</section>
	</main>

	<mvt:item name="hdft" param="footer" />
	<mvt:item name="hdft" param="global_footer" />
</body>
</html>
